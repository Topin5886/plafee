{
  "name": "plafee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ./scripts/spa-fallback.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test:flip7": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/flip7/engine/rules.test.mts",
    "test:p4": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/puissance4/engine/rules.test.mts",
    "test:uno": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/uno/engine/rules.test.mts",
    "test:president": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/president/engine/rules.test.mts && node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/president/engine/ai.test.mts && node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/president/net/seating.test.mts",
    "test:verite": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/verite/engine/rules.test.mts",
    "test:bots": "node --experimental-strip-types --import ./scripts/register-ts.mjs src/features/bots/bots.test.mts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
